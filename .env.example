# ---------------------------------------------------------------------------
# Copy to .env.local for development. In production, set these in Vercel:
#   Project -> Settings -> Environment Variables
#
# .env.local is gitignored. Never commit real keys.
# Full setup instructions with links: see LAUNCH.md
# ---------------------------------------------------------------------------

# --- Mapbox (address autocomplete + distance) ------------------------------
# Enables address autocomplete and driving-distance pricing.
# Uses the Search Box API (suggest/retrieve), Geocoding v6, and Directions.
# Server-side only — do NOT prefix with NEXT_PUBLIC_, or the token leaks to
# every visitor's network tab.
# Without this, the site still works: the quote step becomes a request form.
MAPBOX_ACCESS_TOKEN=

# --- Resend (transactional email) ------------------------------------------
# Sends the booking request to Craig and the confirmation to the customer.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend.
BOOKING_FROM_EMAIL="The Extra Mile <bookings@extramilelimo.com>"

# Where new booking requests land. Craig's real inbox.
BOOKING_TO_EMAIL=craig@extramilelimo.com

# --- Supabase (booking request log) ----------------------------------------
# Optional but recommended: durable record of every request, so a bounced or
# deleted email never loses a customer. See supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
